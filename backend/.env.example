# Base de données PostgreSQL (dev local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_credit_bank?schema=public"

# App
PORT=3000
NODE_ENV=development

# Signature HMAC-SHA256 des webhooks blockchain (Alchemy/QuickNode)
BLOCKCHAIN_WEBHOOK_SIGNING_KEY="change-me"

# CORS — origine du frontend Next.js (dashboard, Step 6)
FRONTEND_ORIGIN="http://localhost:3001"

# Signature des JWT de session (auth réelle). EN PRODUCTION : secret géré par un
# coffre-fort (Vault/KMS/variables d'environnement de la plateforme d'hébergement),
# jamais committé, jamais réutilisé entre environnements. Générer avec :
# openssl rand -hex 32
JWT_SECRET="change-me"

# Mollie (recharge de solde par carte) — vide = mode sandbox (aucun appel réseau réel).
# Renseigner une clé test Mollie (test_...) pour basculer sur l'API Mollie réelle.
MOLLIE_API_KEY=""

# URL publique de ce backend (webhookUrl transmis à Mollie en mode réel — doit être
# joignable depuis internet, ex: tunnel ngrok en local).
BACKEND_PUBLIC_URL="http://localhost:3000"

# CoinMarketCap (données de marché : cours, historique 12 mois, logos, taux EUR/USD —
# cf. MarketDataService). Contrairement à l'ancienne intégration CoinGecko, une clé est
# obligatoire même sur le plan gratuit ("Basic", 15 000 crédits/mois) : en créer une sur
# https://pro.coinmarketcap.com/signup. Sans cette clé, tous les appels échouent et le
# service se dégrade gracieusement (dernières données en cache, ou vide) plutôt que
# d'échouer bruyamment. Un essai de retour à CoinGecko a depuis été abandonné à son tour
# (cf. journal des modifications) — CoinMarketCap reste la source retenue.
COINMARKETCAP_API_KEY=""

# Finnhub (cours réels du panier d'actions du produit "investissement direct" — cf.
# StockMarketDataService, §2H CLAUDE.md). Plan gratuit ("Free"), clé requise : en créer une
# sur https://finnhub.io/register. Sans cette clé, le signal de marché du panier STOCKS
# reste indisponible et l'accrual quotidien applique uniquement la baseline dividende
# indicative (jamais un accrual bloqué, cf. InvestmentService.recordStockBasketRun).
FINNHUB_API_KEY=""

# OpenAI/ChatGPT (assistant support IA réel, /dashboard/support — cf. §6 CLAUDE.md
# entrée #43, OpenAiChatService). Dernier fournisseur retenu après deux essais Google
# Gemini (API "AI Studio" à clé simple, puis Vertex AI — cf. historique complet en
# commentaire de backend/src/support-chat/support-chat.constants.ts). Clé sur
# https://platform.openai.com/api-keys (nécessite un compte avec un moyen de paiement
# configuré, l'API OpenAI n'a pas de niveau gratuit). Sans cette clé, l'endpoint
# /support-chat/message répond 503 et le frontend affiche un message d'indisponibilité —
# jamais une réponse fabriquée sans appel réel au modèle.
OPENAI_API_KEY=""
# Modèle — gpt-5-mini par défaut si non renseigné (cf. OPENAI_DEFAULT_MODEL, à ajuster si
# OpenAI fait évoluer les modèles disponibles : l'erreur HTTP réelle indique alors le nom
# correct, même méthode que celle qui a permis de corriger le modèle Gemini à l'entrée #41).
OPENAI_MODEL=""
