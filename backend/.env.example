# Base de données PostgreSQL (dev local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_credit_bank?schema=public"

# App
PORT=3000
NODE_ENV=development

# Signature HMAC-SHA256 des webhooks blockchain (Alchemy/QuickNode)
BLOCKCHAIN_WEBHOOK_SIGNING_KEY="change-me"

# CORS — origine du frontend Next.js (dashboard, Step 6)
FRONTEND_ORIGIN="http://localhost:3001"

# Signature des JWT de session (auth réelle). EN PRODUCTION : secret géré par un
# coffre-fort (Vault/KMS/variables d'environnement de la plateforme d'hébergement),
# jamais committé, jamais réutilisé entre environnements. Générer avec :
# openssl rand -hex 32
JWT_SECRET="change-me"

# Mollie (recharge de solde par carte) — vide = mode sandbox (aucun appel réseau réel).
# Renseigner une clé test Mollie (test_...) pour basculer sur l'API Mollie réelle.
MOLLIE_API_KEY=""

# URL publique de ce backend (webhookUrl transmis à Mollie en mode réel — doit être
# joignable depuis internet, ex: tunnel ngrok en local).
BACKEND_PUBLIC_URL="http://localhost:3000"

# CoinMarketCap (données de marché : cours, historique 12 mois, logos, taux EUR/USD —
# cf. MarketDataService). Contrairement à l'ancienne intégration CoinGecko, une clé est
# obligatoire même sur le plan gratuit ("Basic", 15 000 crédits/mois) : en créer une sur
# https://pro.coinmarketcap.com/signup. Sans cette clé, tous les appels échouent et le
# service se dégrade gracieusement (dernières données en cache, ou vide si aucun cache) —
# jamais de données de marché inventées.
COINMARKETCAP_API_KEY=""
