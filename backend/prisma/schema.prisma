// Prisma schema — Plateforme Bancaire Crypto-Crédit
// Voir CLAUDE.md chapitre 4 pour le modèle de données de référence.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

// CLIENT = usage courant du compte (dashboard, dépôt, crédit). ADMIN = accès aux routes
// back-office (validation des demandes de crédit, déclenchement manuel des jobs) — cf.
// AdminGuard. Pas encore adossé à une vraie session (aucun login n'existe dans l'app,
// cf. TODO(Step 5 - Auth) sur UsersController) : sert de base au contrôle d'accès par
// rôle, à brancher sur une authentification réelle plus tard.
enum UserRole {
  CLIENT
  ADMIN
}

// Type de compte, choisi à l'ouverture (formulaire public "Demander l'ouverture d'un
// compte", cf. AccountOpeningRequest) et fixé une fois pour toutes — pas de bascule après
// coup. PARTICULIER garde l'accès au crédit gagé crypto (350% du gage, cf.
// CreditEngineService) comme aujourd'hui. BUSINESS s'y ajoute : les deux options
// cohabitent pour un compte business (cf. DirectCreditRequest) — un compte particulier
// n'a lui jamais accès au crédit direct, réservé au financement de projets professionnels.
enum AccountType {
  PARTICULIER
  BUSINESS
}

enum Chain {
  ETHEREUM
  POLYGON
  ARBITRUM
  TRON
  SOLANA
}

// Actifs acceptés en garantie. USDS/DAI/USDE/PYUSD/USDT/USDC sont des stablecoins
// indexés ~1 USD (valorisés 1:1 dans le ledger). PAXG/XAUT/KAG sont indexés sur l'once
// d'or ou d'argent (cf. PRECIOUS_METAL_CURRENCIES), DEURO sur l'euro, et ETH/SHIB sont
// des cryptomonnaies natives (aucun ancrage) : leur valeur en USD est recalculée au prix
// spot en direct au moment du dépôt (cf. MarketDataService), pas fixée à 1:1.
// USDS/USDE/PYUSD/PAXG restent définis pour ne pas invalider les données existantes
// (comptes de démo, positions déjà créées) mais ne sont plus proposés au choix depuis
// l'écran de dépôt/retrait (cf. frontend lib/format.ts — CURRENCY_GROUPS ne montre plus
// que ETH/DAI/USDC/DEURO/USDT/XAUT/KAG/SHIB, tous sur Ethereum).
// XPT/XPD/XCU/WTI — métaux industriels et matières premières tokenisés (Platine,
// Palladium, Cuivre, Pétrole synthétique), issus de la feuille de route "Stratégie
// d'Investissement & Rendements RWA Métaux" : valorisés au cours spot en direct comme
// les métaux précieux (cf. INDUSTRIAL_RWA_CURRENCIES), éligibles au même mécanisme de
// remboursement automatique par plus-value (cf. YIELD_ELIGIBLE_CURRENCIES), et associés
// en plus à un objectif de rendement indicatif propre à la stratégie de trésorerie de la
// banque sur ces actifs (cf. INDICATIVE_TARGET_APY_PCT) — un objectif affiché au client à
// titre indicatif, jamais une garantie ni un taux appliqué au calcul du crédit.
enum AcceptedCurrency {
  USDS
  DAI
  USDE
  PYUSD
  PAXG
  XAUT
  USDT
  USDC
  DEURO
  ETH
  SHIB
  KAG
  XPT
  XPD
  XCU
  WTI
}

enum CreditPositionStatus {
  ACTIVE
  CLOSED
  // Dépréciation sévère du gage constatée par LiquidationService (cf.
  // LIQUIDATION_TRIGGER_DEPRECIATION_PCT) — état terminal comme CLOSED (jamais réactivé),
  // mais distinct : le crédit déjà utilisé sur cette position n'est PAS remboursé, il
  // devient une exposition non garantie pour la banque (le gage qui la couvrait a perdu
  // l'essentiel de sa valeur). Jamais déclenché rétroactivement sur une position déjà
  // CLOSED.
  LIQUIDATED
}

// Devise de la ligne de crédit, choisie par le client au verrouillage (CLAUDE.md §2 —
// structure de taux). Le ledger interne reste en USD ; EUR n'affecte que le taux
// appliqué et l'affichage (conversion au cours en direct, cf. MarketDataService).
enum AccountCurrency {
  USD
  EUR
}

enum CardStatus {
  PENDING
  ACTIVE
  BLOCKED
  CLOSED
}

enum TransactionType {
  DEPOSIT
  COLLATERAL_LOCK
  CREDIT_ISSUED
  CARD_PAYMENT
  REPAYMENT
  WITHDRAWAL
  ORIGINATION_FEE
  INTEREST_PAYMENT
  // Recharge du solde disponible par carte bancaire (Mollie) — distinct de DEPOSIT
  // (dépôt crypto on-chain) : pas de `currency`/`chain`/`tokenAmount`, référence
  // `referenceTx` = identifiant de paiement Mollie.
  CARD_TOPUP
  // Remboursement automatique généré par la plus-value réelle du gage (PAXG/XAUT),
  // appliqué périodiquement par CollateralYieldService — distinct de REPAYMENT (geste
  // explicite du client) pour rester auditable séparément.
  YIELD_REPAYMENT
  // Dépréciation sévère du gage constatée par LiquidationService : le montant du gage
  // (au prix d'entrée) est retiré du bilan (lockedCollateral/grantedCredit), sans effet
  // sur le crédit déjà utilisé (cf. CreditPositionStatus.LIQUIDATED).
  LIQUIDATION
  // Investissement direct (cf. §2H CLAUDE.md, InvestmentService) — placement de fonds
  // réels dans l'un des paniers (cf. InvestmentBasket : RWA_STRATEGY ou l'un des 5
  // paniers STOCKS*), distinct du gage crypto : débite/crédite directement
  // availableBalance, jamais lockedCollateral.
  INVESTMENT_DEPOSIT
  INVESTMENT_WITHDRAWAL
  // Accrual quotidien du rendement réel du panier choisi, appliqué au principal de la
  // position (composé jour après jour) — jamais versé sur availableBalance tant que le
  // client n'a pas retiré sa position (cf. InvestmentService.withdraw).
  INVESTMENT_YIELD_ACCRUAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// Méthode d'un retrait (Transaction.type = WITHDRAWAL uniquement) — CRYPTO existait déjà
// (adresse on-chain, cf. Transaction.chain/destinationAddress) ; SEPA/SWIFT sont des
// virements bancaires classiques. Comme pour CRYPTO (aucune custody réelle branchée,
// cf. WithdrawalService), aucun rail bancaire réel n'est branché ici non plus : la demande
// est journalisée au ledger (débit immédiat du solde disponible), pas réellement exécutée
// vers une banque — cohérent avec le reste du retrait, jamais un virement réellement
// envoyé. SEPA est réservé à l'espace unique de paiement en euros (zone SEPA, EUR
// uniquement) ; SWIFT couvre tout le reste (autre devise ou pays hors zone SEPA).
enum WithdrawalMethod {
  CRYPTO
  SEPA
  SWIFT
}

enum ClientType {
  PARTICULIER
  INDEPENDANT
  ENTREPRISE
}

enum AddressLabel {
  DOMICILE
  FISCALE
  POSTALE
  PROFESSIONNELLE
}

// ---------------------------------------------------------------------------
// MODELS
// ---------------------------------------------------------------------------

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  kycStatus    KycStatus   @default(PENDING)
  role         UserRole    @default(CLIENT)
  // cf. enum AccountType — fixé à l'ouverture du compte, jamais modifié ensuite.
  accountType  AccountType @default(PARTICULIER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Authentification à deux facteurs (TOTP, cf. TwoFactorService) — réservée aux comptes
  // ADMIN (back-office sensible) et désormais obligatoire pour eux (cf. AdminGuard) :
  // twoFactorSecret est renseigné dès la génération du QR code (POST /auth/2fa/setup) mais
  // twoFactorEnabled ne passe à true qu'après confirmation d'un premier code valide (POST
  // /auth/2fa/enable) — un secret généré puis jamais confirmé ne bloque jamais le login,
  // mais AdminGuard bloque alors tout accès back-office autre qu'à ces trois routes.
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  // Verrouillage de compte après échecs de connexion répétés (cf. AuthService,
  // MAX_FAILED_LOGIN_ATTEMPTS) — remis à zéro à chaque connexion réussie.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  wallets               Wallet[]
  ledgerBalance         LedgerBalance?
  creditPositions       CreditPosition[]
  cards                 Card[]
  transactions          Transaction[]
  creditRequests        CreditRequest[]
  // Réservé aux comptes BUSINESS côté service (DirectCreditGuard) — présent sur le modèle
  // pour tous les comptes par simplicité de relation Prisma, toujours vide pour un compte
  // PARTICULIER en pratique.
  directCreditRequests  DirectCreditRequest[]
  // Investissement direct (cf. §2H CLAUDE.md) — ouvert aux comptes PARTICULIER et BUSINESS
  // (contrairement au crédit direct, réservé BUSINESS) : placement de fonds réels, pas un
  // gage. Plusieurs lignes possibles dans le temps (une par cycle dépôt→retrait, comme
  // CreditPosition), au plus une ACTIVE par (userId, basket).
  investmentPositions   InvestmentPosition[]
  // Renseigné uniquement si ce compte a été créé via une demande d'ouverture approuvée
  // (cf. AccountOpeningRequest) — traçabilité, jamais réutilisé pour recalculer quoi que
  // ce soit. Les comptes de seed n'en ont pas.
  accountOpeningRequest AccountOpeningRequest?

  // Fiche client back-office (cf. AdminClientsModule) — "noyau essentiel" de la fiche
  // client 360 admin, en base réelle plutôt que fictive (lib/admin-mock-data.ts côté
  // frontend). Tout nullable/optionnel : un User fraîchement créé (cf.
  // AccountRequestsService.approve) n'a aucune de ces informations tant qu'un client ou
  // un admin ne les a pas complétées.
  clientProfile     ClientProfile?
  addresses         Address[]
  employment        Employment?
  financialSnapshot FinancialSnapshot?
  notes             ClientNote[]       @relation("ClientNotes")
  authoredNotes     ClientNote[]       @relation("AuthoredNotes")

  // Wallet interne "personnel" de suivi (cf. ClientManagedWallet ci-dessous) — pas une
  // adresse blockchain, une identité de compte stable côté back-office.
  managedWallet ClientManagedWallet?

  @@map("users")
}

enum AccountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Formulaire public "Demander l'ouverture d'un compte / être contacté" (cf. app/page.tsx)
// — aucune auto-inscription : le compte (User) n'est créé qu'à l'approbation back-office
// (cf. AccountRequestsService.approve), avec un mot de passe temporaire communiqué au
// client hors-bande (pas de service d'e-mail branché à ce stade).
model AccountOpeningRequest {
  id          String               @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  message     String?
  // Choisi par le demandeur lui-même dans le formulaire public — propagé tel quel au
  // User créé à l'approbation (cf. AccountRequestsService.approve). Un compte BUSINESS
  // débloque le crédit direct (cf. DirectCreditRequest) en plus du crédit gagé crypto.
  accountType AccountType          @default(PARTICULIER)
  status      AccountRequestStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  reviewedAt  DateTime?

  // Renseigné uniquement une fois APPROVED (le User créé à l'approbation).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([email])
  @@map("account_opening_requests")
}

// Adresse de dépôt on-chain générée via le custodian (Circle / DFNS / Fireblocks)
model Wallet {
  id        String           @id @default(uuid())
  userId    String
  chain     Chain
  address   String
  currency  AcceptedCurrency
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Une même adresse EVM reçoit couramment plusieurs stablecoins (ex: USDT et USDC sur la
  // même adresse Ethereum) : l'unicité porte donc sur le triplet, pas sur (chain, address) seul.
  @@unique([chain, address, currency], name: "chainAddressCurrency")
  @@index([userId])
  @@map("wallets")
}

// Adresse de dépôt "pool" gérée par la banque — PAS propre à un client (contrairement à
// Wallet ci-dessus). Une seule adresse par (chain, currency), administrée manuellement
// côté infrastructure (pas de génération automatique). Utilisée par le flux
// "déclaration d'intention de dépôt" (cf. DepositIntentsModule) : le client la consulte
// juste avant d'envoyer ses fonds, jamais affichée par défaut. Comme plusieurs clients
// partagent la même adresse, l'attribution du dépôt au bon client ne peut pas reposer sur
// l'adresse seule (contrairement au webhook blockchain existant pour les Wallet
// individuels) — elle passe par une déclaration du client puis une validation manuelle
// d'un admin (cf. DepositIntentsService.confirm).
model ManagedDepositAddress {
  id        String           @id @default(uuid())
  chain     Chain
  currency  AcceptedCurrency
  address   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([chain, currency])
  @@map("managed_deposit_addresses")
}

// Wallet "personnel" d'un client, adossé à son compte mais géré par la banque (le
// "gestionnaire de dépôt d'actifs") — PAS une adresse blockchain distincte : les dépôts
// sur les actifs mutualisés (USDT/USDC/XAUT/DEURO, cf. ManagedDepositAddress) continuent
// de transiter par l'adresse unique partagée. Cette entité sert uniquement de référence
// interne stable (façon numéro de compte) pour le suivi/reporting du gestionnaire —
// distincte de l'UUID technique du User. Provisionnée à la volée (cf.
// ClientWalletsService.getOrCreate), au premier accès au profil ou à la première
// déclaration de dépôt : "chaque client en aura un" au fil de l'usage, pas rétroactivement.
model ClientManagedWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  reference String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_managed_wallets")
}

// Registre maître (Master Ledger) : un seul solde consolidé par utilisateur.
// Toute mutation doit passer par le LedgerService sous verrou distribué Redis.
model LedgerBalance {
  id               String   @id @default(uuid())
  userId           String   @unique
  availableBalance Decimal  @default(0) @db.Decimal(18, 6)
  lockedCollateral Decimal  @default(0) @db.Decimal(18, 6)
  grantedCredit    Decimal  @default(0) @db.Decimal(18, 6)
  usedCredit       Decimal  @default(0) @db.Decimal(18, 6)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ledger_balances")
}

// Historique des mises en gage / octrois de crédit (une ligne par cycle de gage).
// Porte aussi la structure de taux figée au moment du verrouillage : un changement
// ultérieur du taux de référence ou de la prime de risque n'affecte pas les positions
// déjà ouvertes (même principe que CREDIT_RATIO — pas de recalcul rétroactif).
model CreditPosition {
  id               String               @id @default(uuid())
  userId           String
  collateralAmount Decimal              @db.Decimal(18, 6)
  creditIssued     Decimal              @db.Decimal(18, 6)
  status           CreditPositionStatus @default(ACTIVE)

  // Devise choisie par le client pour cette ligne de crédit (montant/taux affichés
  // dans cette devise) ; le ledger reste comptabilisé en USD (`creditIssued`).
  currency               AccountCurrency @default(USD)
  // Cours EUR/USD appliqué au verrouillage (1.0 si USD) — figé, pas recalculé plus tard.
  exchangeRateAtLock     Decimal         @default(1) @db.Decimal(18, 8)
  // Crédit émis exprimé dans `currency` (= creditIssued si USD, converti au cours
  // figé ci-dessus si EUR) — pour l'affichage, jamais pour la comptabilité du ledger.
  creditIssuedInCurrency Decimal         @default(0) @db.Decimal(18, 6)

  // Structure de taux figée à l'ouverture (SOFR/EURIBOR + prime de risque, cf. §2).
  // Défaut 0 réservé aux positions antérieures à cette fonctionnalité (aucun intérêt
  // ni frais applicable rétroactivement) ; toute nouvelle position fournit ces valeurs explicitement.
  interestRatePct      Decimal  @default(0) @db.Decimal(5, 2)
  originationFeePct    Decimal  @default(0) @db.Decimal(5, 2)
  originationFeeAmount Decimal  @default(0) @db.Decimal(18, 6)
  custodyFeePct        Decimal  @default(0) @db.Decimal(5, 2)
  termMonths           Int      @default(12)
  maturityDate         DateTime @default(now())

  // Actif réellement mis en gage pour cette position (capturé depuis CreditRequest au
  // moment du verrouillage) — nullable : les positions antérieures à cette fonctionnalité
  // n'ont pas cette information et n'accrueront jamais de rendement rétroactivement (même
  // principe de non-rétroactivité que le taux de gage, cf. §2A).
  collateralCurrency             AcceptedCurrency?
  // Quantité de tokens implicite (collateralAmount USD / prix spot au verrouillage) — ne
  // sert qu'au calcul de plus-value ci-dessous, jamais renseignée pour les stablecoins
  // (toujours 1:1, aucune plus-value possible).
  collateralTokenAmount          Decimal?          @db.Decimal(28, 8)
  // Prix spot (USD) au moment du verrouillage — le "prix d'entrée" servant de référence
  // à la plus-value. Uniquement pour PAXG/XAUT (cf. GOLD_CURRENCIES).
  collateralEntryPriceUsd        Decimal?          @db.Decimal(18, 8)
  // Cliquet (high-water mark) du prix déjà "encaissé" via un remboursement automatique
  // par le rendement — ne recule jamais, même si le cours baisse ensuite : une plus-value
  // déjà appliquée au crédit utilisé n'est jamais reprise. Initialisé = collateralEntryPriceUsd.
  collateralYieldAppliedPriceUsd Decimal?          @db.Decimal(18, 8)
  // Cumul du crédit déjà remboursé par le rendement du gage sur CETTE position (cf.
  // YIELD_REPAYMENT_CAP_PCT) — le remboursement automatique s'arrête dès que ce cumul
  // atteint 60% de `creditIssued` ; le reste doit être remboursé manuellement (apport
  // personnel, cf. CreditEngineService.repayCreditAndUnlockCollateral).
  yieldRepaidAmount              Decimal           @default(0) @db.Decimal(18, 6)
  // Alerte précoce de LiquidationService (cf. LIQUIDATION_WARNING_DEPRECIATION_PCT) : le
  // gage a perdu une part significative de sa valeur d'entrée sans avoir encore atteint le
  // seuil de déclenchement (LIQUIDATION_TRIGGER_DEPRECIATION_PCT). Purement informatif —
  // ne bloque rien — et repasse à false si le cours se redresse avant le seuil critique.
  liquidationWarning             Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditRequest CreditRequest?

  @@index([userId])
  @@index([status])
  @@index([collateralCurrency])
  @@map("credit_positions")
}

enum CreditRequestStatus {
  PENDING
  APPROVED
  REJECTED
  // Le dépôt attendu est arrivé et le crédit a été émis automatiquement pour ce montant.
  FULFILLED
}

// Demande de crédit du client (CLAUDE.md — accès au crédit régulé par une demande) :
// le client indique le gage qu'il souhaite constituer, un tiers valide la demande, puis
// seulement à ce moment le client obtient une adresse de dépôt dédiée à cette demande.
// Le crédit n'est jamais émis manuellement : dès qu'un dépôt (crypto ou carte) porte le
// solde disponible au niveau demandé, il est émis automatiquement (cf. CreditRequestsService.tryAutoFulfill),
// remplaçant l'ancien verrouillage instantané en self-service.
model CreditRequest {
  id               String              @id @default(uuid())
  userId           String
  collateralAmount Decimal             @db.Decimal(18, 6)
  currency         AccountCurrency     @default(USD)
  status           CreditRequestStatus @default(PENDING)
  createdAt        DateTime            @default(now())
  validatedAt      DateTime?
  fulfilledAt      DateTime?

  // Actif choisi par le client au moment de générer l'adresse de dépôt dédiée
  // (generateDepositAddress) — fige l'actif de cette demande : un appel ultérieur avec un
  // actif différent est refusé (CollateralCurrencyMismatchException) plutôt que d'accepter
  // silencieusement plusieurs actifs pour une même demande. Propagé à CreditPosition lors
  // de l'émission automatique du crédit (cf. CreditRequestsService.tryAutoFulfill).
  collateralCurrency AcceptedCurrency?

  // Position de crédit résultant de l'auto-fulfillment (renseignée uniquement une fois
  // FULFILLED) — traçabilité, jamais réutilisée pour recalculer quoi que ce soit.
  creditPositionId String?         @unique
  creditPosition   CreditPosition? @relation(fields: [creditPositionId], references: [id])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("credit_requests")
}

enum DirectCreditDecision {
  ELIGIBLE
  INELIGIBLE
}

// Crédit direct — non gagé, réservé aux comptes BUSINESS pour financer un projet
// professionnel (cf. AccountType, CLAUDE.md §2). Décision automatique à la soumission
// (DirectCreditService.evaluate), pas de file d'attente admin : cinq critères déclaratifs
// (ancienneté, revenu minimum, ratio d'endettement, garantie de remboursement, plafond
// relatif au revenu — cf. direct-credit.constants.ts) évalués sur des données auto-
// déclarées par le client, jamais vérifiées par un tiers (aucun fournisseur de
// vérification de revenus/registre du commerce n'est branché à ce stade). `eligible`
// n'émet PAS de crédit : c'est une réponse informative, cohérent avec le reste du produit
// où aucune émission de crédit ne se fait sans une étape humaine/de garantie (cf.
// CreditRequest, DepositIntents).
model DirectCreditRequest {
  id                      String               @id @default(uuid())
  userId                  String
  companyName             String
  registrationNumber      String
  sector                  String
  companySeniorityMonths  Int
  projectDescription      String
  requestedAmount         Decimal              @db.Decimal(18, 6)
  currency                AccountCurrency      @default(USD)
  declaredMonthlyRevenue  Decimal              @db.Decimal(18, 6)
  declaredMonthlyExpenses Decimal              @db.Decimal(18, 6)
  guaranteeOffered        Decimal              @db.Decimal(18, 6) @default(0)
  decision                DirectCreditDecision
  // Détail des 5 critères tel qu'affiché au client au moment de la décision (libellé,
  // résultat, valeur observée vs seuil) — figé, jamais recalculé rétroactivement si les
  // seuils changent ensuite (même principe de non-rétroactivité que CREDIT_RATIO).
  eligibilityBreakdown    Json
  estimatedRatePct        Decimal              @db.Decimal(6, 3)
  estimatedMonthlyPayment Decimal              @db.Decimal(18, 6)
  createdAt               DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([decision])
  @@map("direct_credit_requests")
}

// Carte Visa/Mastercard émise via Stripe Issuing / Marqeta
model Card {
  id             String     @id @default(uuid())
  userId         String
  externalCardId String     @unique
  status         CardStatus @default(PENDING)
  creditLimit    Decimal    @db.Decimal(18, 6)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cards")
}

// Journal append-only de tous les mouvements financiers (source de vérité pour l'audit).
model Transaction {
  id                 String            @id @default(uuid())
  userId             String
  type               TransactionType
  // Montant en USD, tel qu'appliqué au ledger (après conversion au prix spot pour PAXG/XAUT).
  amount             Decimal           @db.Decimal(18, 6)
  status             TransactionStatus @default(PENDING)
  // Renseignés pour les DEPOSIT : l'actif on-chain réellement envoyé et sa quantité brute,
  // pour l'audit — distincts de `amount` (USD) dès qu'un actif n'est pas indexé 1:1 (or).
  currency           AcceptedCurrency?
  tokenAmount        Decimal?          @db.Decimal(28, 8)
  // Renseignés pour les WITHDRAWAL (réseau + adresse externe destinataire) ET pour les
  // DEPOSIT déclarés via le flux d'adresse "pool" (réseau + adresse ManagedDepositAddress
  // affichée au client au moment de la déclaration, cf. DepositIntentsService).
  chain              Chain?
  // Adresse on-chain (CRYPTO) OU IBAN/numéro de compte (SEPA/SWIFT) selon
  // `withdrawalMethod` — un seul champ générique "destination du retrait", pas dupliqué
  // par méthode.
  destinationAddress String?
  // Renseignés uniquement pour un WITHDRAWAL bancaire (SEPA/SWIFT) — `null` pour un
  // retrait CRYPTO (cf. WithdrawalMethod). `withdrawalCurrency` est la devise fiat réelle
  // du virement (USD/EUR), distincte de `currency` (jeton crypto) qui reste `null` ici.
  // `bankBic` est obligatoire pour SWIFT, optionnel pour SEPA (la règle IBAN-only rend le
  // BIC facultatif pour un virement SEPA depuis 2016, mais utile pour l'affichage/l'audit
  // s'il est fourni).
  withdrawalMethod   WithdrawalMethod?
  withdrawalCurrency AccountCurrency?
  bankAccountHolder  String?
  bankBic            String?
  // Idempotence des webhooks blockchain (Alchemy/QuickNode redélivrent parfois le même
  // événement) : un hash de tx on-chain ne doit créditer le solde qu'une seule fois.
  referenceTx        String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// FICHE CLIENT BACK-OFFICE — "noyau essentiel" (cf. AdminClientsModule)
// ---------------------------------------------------------------------------

// Profil KYC/personnel du client — distinct de User (identité d'authentification only :
// email + mot de passe). Nullable par défaut : AccountRequestsService.approve ne crée
// qu'un User nu, ce profil se complète ensuite (client ou admin).
model ClientProfile {
  id            String     @id @default(uuid())
  userId        String     @unique
  firstName     String?
  lastName      String?
  dateOfBirth   DateTime?
  placeOfBirth  String?
  nationality   String?
  maritalStatus String?
  dependents    Int?
  phone         String?
  clientType    ClientType @default(PARTICULIER)
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

// Une adresse par label (domicile/fiscale/postale/professionnelle) — au plus une ligne
// par (userId, label), mise à jour en place plutôt que ré-empilée.
model Address {
  id            String       @id @default(uuid())
  userId        String
  label         AddressLabel
  street        String
  city          String
  postalCode    String
  country       String
  residenceType String?
  since         String?
  verified      Boolean      @default(false)
  verifiedAt    DateTime?
  updatedAt     DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId])
  @@map("addresses")
}

model Employment {
  id            String   @id @default(uuid())
  userId        String   @unique
  isIndependent Boolean  @default(false)
  status        String?
  employer      String?
  sector        String?
  role          String?
  seniority     String?
  annualIncome  Decimal? @db.Decimal(18, 2)
  monthlyIncome Decimal? @db.Decimal(18, 2)
  contractType  String?
  verified      Boolean  @default(false)
  // Champs spécifiques à un client indépendant (isIndependent = true) — nuls sinon.
  activity      String?
  turnover      Decimal? @db.Decimal(18, 2)
  netResult     Decimal? @db.Decimal(18, 2)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employments")
}

// Déclaration financière — revenus/charges/patrimoine/passifs stockés en JSON structuré
// plutôt qu'en une vingtaine de colonnes Decimal séparées : ce sont des blocs
// déclaratifs toujours lus/écrits ensemble (jamais interrogés champ par champ en base),
// le typage réel vit côté DTO (cf. admin-clients/dto/update-financials.dto.ts).
model FinancialSnapshot {
  id          String   @id @default(uuid())
  userId      String   @unique
  income      Json?
  expenses    Json?
  assets      Json?
  liabilities Json?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("financial_snapshots")
}

// Note interne back-office sur un dossier client — jamais exposée côté client (cf.
// AdminClientsController, entièrement réservé au rôle ADMIN).
model ClientNote {
  id           String   @id @default(uuid())
  userId       String
  authorUserId String
  content      String
  createdAt    DateTime @default(now())

  user   User @relation("ClientNotes", fields: [userId], references: [id], onDelete: Cascade)
  author User @relation("AuthoredNotes", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("client_notes")
}

// Une ligne par jour de simulation de la stratégie de trésorerie décrite dans la feuille
// de route "Stratégie d'Investissement & Rendements RWA Métaux" (cf. TreasuryBotService,
// components/marketing/rwa-strategy-section.tsx) — SIMULATION UNIQUEMENT : aucun ordre
// n'est passé, aucun fonds réel ne bouge, aucune connexion à un exchange ou wallet réel.
// Le rendement journalier de chaque pilier est calculé à partir de vraies données de
// marché (variation moyenne du panier de métaux industriels/matières premières
// tokenisés), pas d'un tirage aléatoire, mais reste un calcul de démonstration : cette
// table n'a aucun effet sur le ledger, le crédit ou tout compte client.
model TreasuryBotRun {
  id                 String   @id @default(uuid())
  // Tronqué au jour (UTC) — une ligne par jour, réécrite si le job est redéclenché le même
  // jour (cf. upsert dans TreasuryBotService), jamais dupliquée.
  runDate            DateTime @db.Date
  pillarAReturnPct   Decimal  @db.Decimal(9, 6)
  pillarBReturnPct   Decimal  @db.Decimal(9, 6)
  pillarCReturnPct   Decimal  @db.Decimal(9, 6)
  // Moyenne simple des 3 piliers (pondération égale, choix documenté dans le service).
  blendedReturnPct   Decimal  @db.Decimal(9, 6)
  // Variation moyenne du panier d'actifs RWA industriels ce jour-là — le signal de marché
  // réel dont dérive le rendement de chaque pilier (cf. PILLAR_MARKET_SENSITIVITY).
  marketSignalPct    Decimal  @db.Decimal(9, 6)
  notionalCapitalUsd Decimal  @db.Decimal(18, 2)
  dailyPnlUsd        Decimal  @db.Decimal(18, 2)
  // Capital simulé cumulé (composé jour après jour depuis NOTIONAL_CAPITAL_USD) — c'est la
  // courbe de performance affichée sur /admin/algorithme.
  cumulativeNavUsd   Decimal  @db.Decimal(18, 2)
  createdAt          DateTime @default(now())

  @@unique([runDate])
  @@map("treasury_bot_runs")
}

// Investissement direct (cf. §2H CLAUDE.md, InvestmentService) — le client choisit un
// panier au dépôt (RWA_STRATEGY : même stratégie que TreasuryBotService, désormais
// ouverte au capital client réel en plus du capital notionnel interne ; les 5 paniers
// STOCKS* : chacun un sous-ensemble d'actions cotées réelles, cf. StockMarketDataService,
// STOCK_SUB_BASKETS) et place des fonds réels depuis son solde disponible — contrairement
// au gage crypto (§2A), rien n'est verrouillé en garantie d'un crédit, c'est un placement
// à part entière, avec un vrai risque de perte (le rendement quotidien peut être négatif
// un jour de marché défavorable).
// STOCKS (historique, dividendes blue chip) et les 4 paniers ajoutés à l'entrée #27 du
// journal (CONSERVATIVE/BALANCED/TECH_AI/MOMENTUM) coexistent volontairement, sans
// remplacement ni fusion — un chevauchement de titres entre STOCKS et
// STOCKS_CONSERVATIVE (JNJ, PG, KO communs aux deux) est assumé, chaque panier reste une
// sélection indépendante.
enum InvestmentBasket {
  RWA_STRATEGY
  STOCKS
  STOCKS_CONSERVATIVE
  STOCKS_BALANCED
  STOCKS_TECH_AI
  STOCKS_MOMENTUM
}

enum InvestmentPositionStatus {
  ACTIVE
  CLOSED
}

model InvestmentPosition {
  id     String           @id @default(uuid())
  userId String
  basket InvestmentBasket

  // Capital placé (cumulé sur les dépôts successifs tant que la position reste ACTIVE) et
  // rendement composé accru quotidiennement (cf. InvestmentService.runDailyAccrual) —
  // jamais versé sur availableBalance avant un retrait complet (withdraw), qui clôture la
  // position et journalise principalAmount + accruedYield en une seule Transaction
  // INVESTMENT_WITHDRAWAL.
  principalAmount Decimal                  @default(0) @db.Decimal(18, 6)
  accruedYield    Decimal                  @default(0) @db.Decimal(18, 6)
  status          InvestmentPositionStatus @default(ACTIVE)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  closedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("investment_positions")
}

// Rendement quotidien réel d'un panier d'actions (cf. StockMarketDataService,
// STOCK_SUB_BASKETS) — pendant de TreasuryBotRun pour les paniers RWA : une ligne par
// (jour, panier) (upsert si le job est redéclenché le même jour pour le même panier),
// jamais recalculée à la volée lors de l'accrual pour rester déterministe (le cours d'une
// action varie en continu dans la journée, contrairement à un accrual qui doit produire
// le même résultat à chaque relecture). `basket` distingue les 5 paniers actions
// (STOCKS/STOCKS_CONSERVATIVE/STOCKS_BALANCED/STOCKS_TECH_AI/STOCKS_MOMENTUM) depuis
// l'entrée #27 du journal — jamais RWA_STRATEGY, qui a sa propre table (TreasuryBotRun).
// Défaut STOCKS conservé pour les lignes déjà écrites avant l'ajout de cette colonne.
model StockBasketRun {
  id      String           @id @default(uuid())
  runDate DateTime         @db.Date
  basket  InvestmentBasket @default(STOCKS)

  // Moyenne réelle de la variation quotidienne (%) des tickers du panier (Finnhub) — le
  // seul chiffre non fabriqué de ce modèle.
  marketSignalPct Decimal @db.Decimal(9, 6)
  // Baseline dividende indicatif du panier (STOCK_SUB_BASKETS[basket].dividendYieldPct /
  // 365, hypothèse de stratégie éditoriale, comme PILLAR_TARGET_APY_PCT pour la RWA,
  // jamais une donnée de marché) + marketSignalPct — appliqué tel quel aux positions de
  // ce panier ce jour-là (cf. InvestmentService.accrueYieldForPosition).
  dailyReturnPct Decimal @db.Decimal(9, 6)

  createdAt DateTime @default(now())

  @@unique([runDate, basket])
  @@map("stock_basket_runs")
}
